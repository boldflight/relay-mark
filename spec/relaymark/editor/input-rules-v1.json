{
  "fixture_version": 1,
  "description": "Typed Markdown shortcuts every RelayMark editor applies, as the web editor's TipTap input rules do. Each case types `text` at the caret `caret` (a ProseMirror position) of `before`. `after` is the document afterwards, compared with schema defaults filled and block identity (relaymarkId, headingId) removed; null means no rule applies and the text is typed as usual. `selection` is the caret afterwards.",
  "cases": [
    {
      "name": "A hyphen and space start a bullet list",
      "rule": "bulletList",
      "before": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "-"
              }
            ]
          }
        ]
      },
      "caret": 2,
      "text": " ",
      "after": {
        "type": "doc",
        "content": [
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph"
                  }
                ]
              }
            ]
          }
        ]
      },
      "selection": 3
    },
