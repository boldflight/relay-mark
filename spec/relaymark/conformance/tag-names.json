{
  "version": 1,
  "about": "The one tag-name rule. relay-elixir owns this table; relay-swift and relay-mark copy it verbatim. Server, web, Swift and RelayMark tests all read it.",
  "rule": [
    "NFKC-normalize the input (full-width ASCII, half-width kana and the ideographic space fold here)",
    "trim surrounding whitespace, then drop leading '#' characters",
    "lowercase each character with its full, context-free Unicode lowercase mapping (no final-sigma rule)",
    "replace each run of characters that are not letters (L), marks (M) or numbers (N) with '-'; '_' and '-' are separators too, so ASCII tags keep their old form",
    "trim leading and trailing '-'; an empty result is no tag (null)"
  ],
  "cases": [
    {"input": "work", "tag": "work"},
    {"input": "Work", "tag": "work"},
    {"input": "#Work Stuff", "tag": "work-stuff"},
    {"input": "##today", "tag": "today"},
    {"input": "  #Q4 2026!  ", "tag": "q4-2026"},
    {"input": "foo_bar", "tag": "foo-bar"},
    {"input": "foo--bar", "tag": "foo-bar"},
    {"input": "-foo-", "tag": "foo"},
    {"input": "a/b.c", "tag": "a-b-c"},
    {"input": "C++", "tag": "c"},
    {"input": "foo\tbar\nbaz", "tag": "foo-bar-baz"},
    {"input": "仕事", "tag": "仕事"},
    {"input": "#仕事", "tag": "仕事"},
    {"input": "しごと", "tag": "しごと"},
    {"input": "シゴト", "tag": "シゴト"},
    {"input": "ｼｺﾞﾄ", "tag": "シゴト"},
    {"input": "ラーメン", "tag": "ラーメン"},
    {"input": "人々", "tag": "人々"},
    {"input": "ばか", "tag": "ばか"},
    {"input": "＃仕事", "tag": "仕事"},
    {"input": "仕事　メモ", "tag": "仕事-メモ"},
    {"input": "仕事・家庭", "tag": "仕事-家庭"},
    {"input": "日本語_タグ", "tag": "日本語-タグ"},
    {"input": "東京2026", "tag": "東京2026"},
    {"input": "ＡＢＣ１２３", "tag": "abc123"},
    {"input": "①", "tag": "1"},
    {"input": "Ⅻ", "tag": "xii"},
    {"input": "한국어", "tag": "한국어"},
    {"input": "١٢٣", "tag": "١٢٣"},
    {"input": "Café", "tag": "café"},
    {"input": "Café", "tag": "café"},
    {"input": "Straße", "tag": "straße"},
    {"input": "ΣΑΣ", "tag": "σασ"},
    {"input": "İstanbul", "tag": "i̇stanbul"},
    {"input": "foo​bar", "tag": "foo-bar"},
    {"input": "🎉party", "tag": "party"},
    {"input": "🎉", "tag": null},
    {"input": "", "tag": null},
    {"input": "   ", "tag": null},
    {"input": "#", "tag": null},
    {"input": "---", "tag": null},
    {"input": "　", "tag": null}
  ]
}
