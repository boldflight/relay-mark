{
  "version": 1,
  "about": "The one tag-name rule and the editor trigger rule. relay-elixir owns this table; relay-swift and relay-mark copy it verbatim. Server, web, Swift and RelayMark tests read it.",
  "rule": [
    "NFKC-normalize the input (full-width ASCII such as '＃' and 'Ａ', half-width kana and the ideographic space fold here)",
    "trim surrounding whitespace, then drop leading '#' characters",
    "lowercase each character with its full, context-free Unicode lowercase mapping (no final-sigma rule)",
    "keep letters (L), combining marks (M), decimal digits (Nd) and letter numbers (Nl, such as 〇); replace each run of anything else (spaces, '_', '-', '#', punctuation, symbols, emoji) with '-'",
    "a tag starts with a letter or number: trim leading '-' and combining marks, and trailing '-'; an empty result is no tag (null)"
  ],
