  "triggers": {
    "about": "Typed sigils open the editor menus. `before` is the committed paragraph text before the caret; `trigger` is the menu it opens, or null. Each sigil has an ASCII and a full-width form; choosing from the menu writes the canonical ASCII form. A sigil opens a menu at the start of a line, after whitespace, or after a Han, kana, CJK punctuation or full-width character (other than a sigil), since Japanese has no spaces. Tag and command queries hold no whitespace. Text an input method has not committed never opens a menu.",
    "sigils": {
      "tag": [
        "#",
        "＃"
      ],
      "mention": [
        "@",
        "＠"
      ],
      "command": [
        "/",
        "／"
      ]
    },
