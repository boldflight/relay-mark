{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaynotes.com/spec/relaymark/schemas/relaymark-conformance-suite.schema.json",
  "title": "RelayMark Conformance Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "contract_version", "fixtures"],
  "properties": {
    "type": {
      "const": "relaymark.conformance_suite"
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "fixtures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "source": {
          "type": "string"
        },
        "cases": {
          "description": "Editor rules run by relaymark-core job name: each case names a job, its input and options, and the job's exact output.",
          "type": "string"
        },
        "input_ast": {
          "type": "string"
        },
        "input_manifest": {
          "type": "string"
        },
        "input_composition": {
          "type": "string"
        },
        "expected_ast": {
          "type": "string"
        },
        "expected_manifest": {
          "type": "string"
        },
        "expected_diagnostics": {
          "type": "string"
        },
        "expected_composition": {
          "type": "string"
        },
        "schemas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "validation_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {
              "type": "string",
              "enum": ["scripture_ask"]
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["cases"],
          "not": {
            "anyOf": [
              {"required": ["source"]},
              {"required": ["input_ast"]},
              {"required": ["input_manifest"]},
              {"required": ["input_composition"]},
              {"required": ["expected_ast"]},
              {"required": ["expected_manifest"]},
              {"required": ["expected_diagnostics"]},
              {"required": ["expected_composition"]},
              {"required": ["schemas"]},
              {"required": ["validation_context"]}
            ]
          }
        },
        {
          "required": ["source"],
          "not": {
            "anyOf": [
              {"required": ["cases"]},
              {"required": ["input_ast"]},
              {"required": ["input_manifest"]},
              {"required": ["input_composition"]}
            ]
          }
        },
        {
          "required": ["input_ast"],
          "not": {
            "anyOf": [
              {"required": ["cases"]},
              {"required": ["source"]},
              {"required": ["input_composition"]}
            ]
          }
        },
        {
          "required": ["input_composition", "expected_composition"],
          "not": {
            "anyOf": [
              {"required": ["cases"]},
              {"required": ["source"]},
              {"required": ["input_ast"]},
              {"required": ["input_manifest"]}
            ]
          }
        }
      ]
    }
  }
}
