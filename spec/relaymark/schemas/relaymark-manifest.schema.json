{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaynotes.com/spec/relaymark/schemas/relaymark-manifest.schema.json",
  "title": "RelayMark Projection Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version"],
  "properties": {
    "type": {
      "const": "relaymark.manifest"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "default": []
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mention"
      },
      "default": []
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "default": []
    },
    "forms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formQuestion"
      },
      "default": []
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "default": []
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "default": []
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      },
      "default": []
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "relaymark-diagnostic.schema.json"
      },
      "default": []
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "action", "review"],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "additionalProperties": true
        },
        "target": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "review": {
          "type": "string",
          "enum": ["draft", "ready", "accepted", "rejected"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "kind", "label"],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["entity", "event", "note", "task", "unresolved"]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "type"],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "pattern": "^relay\\.[a-z][a-z0-9_]*_ref$",
          "not": {
            "enum": ["relay.file_ref", "relay.note_ref", "relay.url_ref"]
          }
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      }
    },
    "formQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "key", "label", "field_type"],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "field_type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "kind"],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["source_bundle", "transcript_range", "note_ref", "file_ref", "url_ref"]
        },
        "source_id": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "key", "status", "evidence_refs", "text"],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["unverified", "supported", "disputed", "refuted", "resolved"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "subjects", "criteria", "values", "layout", "evidence_refs", "summary"],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": true
        },
        "preferred": {
          "type": "string"
        },
        "layout": {
          "type": "string",
          "enum": ["table", "bar", "timeline", "checklist", "radar", "heatmap"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
