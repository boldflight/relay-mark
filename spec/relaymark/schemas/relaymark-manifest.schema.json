{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaynotes.com/spec/relaymark/schemas/relaymark-manifest.schema.json",
  "title": "RelayMark Projection Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "const": "relaymark.manifest"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "default": []
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mention"
      },
      "default": []
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "default": []
    },
    "forms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formQuestion"
      },
      "default": []
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "default": []
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "default": []
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      },
      "default": []
    },
    "entity_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityReference"
      },
      "default": []
    },
    "property_sheets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/propertySheet"
      },
      "default": []
    },
    "data_views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataView"
      },
      "default": []
    },
    "layouts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layout"
      },
      "default": []
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "default": []
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "relaymark-diagnostic.schema.json"
      },
      "default": []
    }
  },
  "$defs": {
    "entityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "id",
        "projection"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "projection": {
          "type": "string",
          "enum": [
            "link",
            "chip",
            "card"
          ]
        }
      }
    },
    "propertySheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "binding",
        "fields",
        "presentation"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "title": {
          "type": "string"
        },
        "presentation": {
          "type": "string",
          "enum": [
            "stack",
            "inline",
            "compact"
          ]
        }
      }
    },
    "dataView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "source",
        "projection",
        "columns",
        "sort"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "type": "string",
          "enum": [
            "list",
            "table",
            "feed",
            "calendar",
            "kanban",
            "chart"
          ]
        },
        "columns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filter": {
          "type": "object",
          "additionalProperties": true
        },
        "sort": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "title": {
          "type": "string"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "mode"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "one_column",
            "adaptive_columns"
          ]
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "label": {
          "type": "string"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "id",
        "fallback"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "fallback": {
          "type": "string",
          "enum": [
            "children",
            "plain_text",
            "summary",
            "omit"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "action",
        "review"
      ],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_record_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_revision": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "additionalProperties": true
        },
        "target": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "review": {
          "type": "string",
          "enum": [
            "draft",
            "ready",
            "accepted",
            "rejected",
            "undone"
          ]
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "undo_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "review": {
              "enum": [
                "draft",
                "ready",
                "accepted",
                "rejected"
              ]
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "proposal_id"
                ]
              },
              {
                "required": [
                  "proposal_record_id"
                ]
              },
              {
                "required": [
                  "proposal_revision"
                ]
              },
              {
                "required": [
                  "decision_id"
                ]
              },
              {
                "required": [
                  "execution_id"
                ]
              },
              {
                "required": [
                  "undo_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "proposal_id",
            "proposal_record_id",
            "proposal_revision"
          ],
          "properties": {
            "review": {
              "enum": [
                "draft",
                "ready"
              ]
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "decision_id"
                ]
              },
              {
                "required": [
                  "execution_id"
                ]
              },
              {
                "required": [
                  "undo_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "proposal_id",
            "proposal_record_id",
            "proposal_revision",
            "decision_id",
            "execution_id"
          ],
          "properties": {
            "review": {
              "const": "accepted"
            }
          },
          "not": {
            "required": [
              "undo_id"
            ]
          }
        },
        {
          "required": [
            "proposal_id",
            "proposal_record_id",
            "proposal_revision",
            "decision_id"
          ],
          "properties": {
            "review": {
              "const": "rejected"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "execution_id"
                ]
              },
              {
                "required": [
                  "undo_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "proposal_id",
            "proposal_record_id",
            "proposal_revision",
            "decision_id",
            "execution_id",
            "undo_id"
          ],
          "properties": {
            "review": {
              "const": "undone"
            }
          }
        }
      ]
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "kind",
        "label"
      ],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "entity",
            "event",
            "note",
            "task",
            "unresolved"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "type"
      ],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "pattern": "^relay\\.[a-z][a-z0-9_]*_ref$",
          "not": {
            "enum": [
              "relay.evidence_ref",
              "relay.file_ref",
              "relay.note_ref",
              "relay.url_ref"
            ]
          }
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      }
    },
    "formQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "key",
        "label",
        "field_type"
      ],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "field_type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "kind"
      ],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "source_bundle",
            "evidence_ref",
            "transcript_range",
            "note_ref",
            "file_ref",
            "url_ref"
          ]
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        },
        "selector": {
          "type": "object",
          "additionalProperties": true
        },
        "scope": {
          "type": "string",
          "enum": [
            "private",
            "org",
            "unlisted",
            "public"
          ]
        },
        "bundle_revision": {
          "type": "integer",
          "minimum": 0
        },
        "source_hash": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "scripture_release": {
          "$ref": "#/$defs/scriptureRelease"
        }
      },
      "oneOf": [
        {
          "required": [
            "kind",
            "source_id"
          ],
          "properties": {
            "kind": {
              "const": "source_bundle"
            }
          }
        },
        {
          "required": [
            "kind",
            "evidence_id",
            "source_id",
            "source_type",
            "source_revision",
            "selector",
            "scope",
            "excerpt",
            "scripture_release"
          ],
          "properties": {
            "kind": {
              "const": "evidence_ref"
            },
            "source_type": {
              "const": "scripture"
            },
            "selector": {
              "$ref": "#/$defs/scriptureSpan"
            },
            "excerpt": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "kind",
            "evidence_id",
            "source_id"
          ],
          "properties": {
            "kind": {
              "const": "evidence_ref"
            }
          },
          "not": {
            "required": [
              "source_type"
            ],
            "properties": {
              "source_type": {
                "const": "scripture"
              }
            }
          }
        },
        {
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "transcript_range",
                "note_ref",
                "file_ref",
                "url_ref"
              ]
            }
          }
        }
      ]
    },
    "scriptureRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "translation_id",
        "edition_id",
        "corpus_release_id",
        "versification_id",
        "source",
        "license",
        "attribution",
        "provenance"
      ],
      "properties": {
        "profile": {
          "const": "relaymark.scripture_release"
        },
        "translation_id": {
          "type": "string",
          "minLength": 1
        },
        "edition_id": {
          "type": "string",
          "minLength": 1
        },
        "corpus_release_id": {
          "type": "string",
          "minLength": 1
        },
        "versification_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/scriptureSource"
        },
        "license": {
          "$ref": "#/$defs/scriptureLicense"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/scriptureProvenance"
        }
      }
    },
    "scriptureSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "uri",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "scriptureLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scriptureProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_inventory_digest",
        "normalized_index_input_digest"
      ],
      "properties": {
        "coordinate_inventory_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "normalized_index_input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_archive_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "imported_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scriptureCoordinate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "book_id",
            "coordinate_kind",
            "chapter",
            "verse_label"
          ],
          "properties": {
            "book_id": {
              "type": "string",
              "minLength": 1
            },
            "coordinate_kind": {
              "const": "chapter"
            },
            "chapter": {
              "type": "integer",
              "minimum": 1
            },
            "verse_label": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "book_id",
            "coordinate_kind",
            "section_id",
            "verse_label"
          ],
          "properties": {
            "book_id": {
              "type": "string",
              "minLength": 1
            },
            "coordinate_kind": {
              "const": "section"
            },
            "section_id": {
              "type": "string",
              "minLength": 1
            },
            "verse_label": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "scriptureSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "start",
        "end",
        "content_digest"
      ],
      "properties": {
        "profile": {
          "const": "relaymark.scripture_span"
        },
        "start": {
          "$ref": "#/$defs/scriptureCoordinate"
        },
        "end": {
          "$ref": "#/$defs/scriptureCoordinate"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "display_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "key",
        "status",
        "evidence_refs",
        "text"
      ],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "unverified",
            "supported",
            "disputed",
            "refuted",
            "resolved"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "subjects",
        "criteria",
        "values",
        "layout",
        "evidence_refs",
        "summary"
      ],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": true
        },
        "preferred": {
          "type": "string"
        },
        "layout": {
          "type": "string",
          "enum": [
            "table",
            "bar",
            "timeline",
            "checklist",
            "radar",
            "heatmap"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
