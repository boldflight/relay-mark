{
  "$schema": "../schemas/relaymark-directive.schema.json",
  "category": "form",
  "validation": [
    "Question and option identities are stable; form authorization and publishing remain host-owned."
  ],
  "projections": {
    "relay_kit": "FormQuestion",
    "html": "form-question",
    "plain_text": "authored labels",
    "manifest": [
      "forms"
    ]
  },
  "policy": {
    "requires_review": false,
    "requires_evidence": false,
    "allows_agent_creation": true
  },
  "name": "FormQuestion",
  "ast_type": "relay.form_question",
  "description": "One canonical collaborative form question with rich label and independently identified options.",
  "attributes": {
    "id": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "string",
      "required": true
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "points": {
      "type": "number",
      "nullable": true
    },
    "min": {
      "type": "number",
      "nullable": true
    },
    "max": {
      "type": "number",
      "nullable": true
    },
    "settings": {
      "type": "object",
      "default": {}
    }
  },
  "children": {
    "mode": "block",
    "allowed_types": [
      "paragraph",
      "relay.form_option"
    ],
    "min": 1
  }
}
