{
  "name": "@relay/relay-mark",
  "private": true,
  "description": "RelayMark specification and reference runtime.",
  "type": "module",
  "bin": {
    "relaymark": "./bin/relaymark.mjs"
  },
  "scripts": {
    "test": "node --test",
    "test:swift": "swift test",
    "test:elixir": "cd adapters/elixir && mix test",
    "test:adapters": "npm run test:swift && npm run test:elixir",
    "conformance": "node bin/relaymark.mjs conformance spec/relaymark/conformance/suite.json",
    "check:contract": "node scripts/check-contract-version.mjs",
    "check": "npm run check:contract && npm test && npm run conformance && npm run test:adapters",
    "build:collaboration": "node scripts/build-collaboration.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.25.9",
    "y-protocols": "1.0.7",
    "yjs": "https://github.com/boldflight/yjs/releases/download/v13.6.33-relay.1/yjs-13.6.33.tgz"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@tiptap/y-tiptap": "3.0.9",
    "core-js-pure": "3.50.0",
    "markdown-it": "^15.0.2",
    "prosemirror-model": "1.25.12",
    "prosemirror-transform": "1.12.2"
  }
}
